# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/explorance

# Gemini API Key for code analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Redis connection for BullMQ (Required if USE_REAL_QUEUE=true)
REDIS_URL=redis://localhost:6379

# Queue configuration
# Set to true to use real BullMQ/Redis, false to use in-memory mock
USE_REAL_QUEUE=false

# Port for Next.js (default is 3000)
PORT=3000
