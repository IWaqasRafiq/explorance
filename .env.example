# DATABASE
MONGODB_URI=mongodb+srv://...
REDIS_URL=redis://localhost:6379

# AI SERVICES
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_TEXT=gemini-2.0-flash
AI_PROMPT_MAX_FILES=12
AI_GEMINI_TIMEOUT_MS=20000
AI_OLLAMA_TIMEOUT_MS=90000

# EMBEDDINGS / VECTORIZATION
ANALYSIS_CHUNK_LIMIT=200
BLOCK_ON_VECTORIZATION=false
EMBEDDING_BATCH_SIZE=12
EMBEDDING_GEMINI_TIMEOUT_MS=10000
EMBEDDING_OLLAMA_TIMEOUT_MS=30000
REPO_DOWNLOAD_TIMEOUT_MS=120000
MAX_REPO_ZIP_BYTES=83886080
MAX_REPO_UNZIPPED_BYTES=314572800
MAX_REPO_ZIP_ENTRIES=50000
LARGE_REPO_FILE_THRESHOLD=180
PARTIAL_REPORT_FILE_LIMIT=120
ENABLE_BACKGROUND_REPORT_ENRICHMENT=true
INCLUDE_AI_IN_PARTIAL_REPORT=false

# PRODUCTION SECURITY (Required in production)
ADMIN_API_KEY=your_secure_random_string
NEXT_PUBLIC_ADMIN_API_KEY=your_secure_random_string

# VECTOR SEARCH (Set to true if using MongoDB Atlas Vector Search Index)
USE_MONGODB_VECTOR=false

# QUEUE SETTINGS
USE_REAL_QUEUE=true

# NEXT SETTINGS
NODE_ENV=development
NEXT_PUBLIC_STATUS_POLL_MS=1200
NEXT_PUBLIC_STALE_JOB_MS=180000
NEXT_PUBLIC_MAX_POLL_MS=1200000
